#!/usr/bin/env bash

set -e

if [[ -n "${DEBUG}" ]]; then
    set -x
fi

# Bug in 2.4.0
if [[ -d /opt/solr/server/solr/configsets/configsets ]]; then
    rm -rf /opt/solr/server/solr/configsets/configsets
fi

# Current Solr distributions ship bundled config sets as regular directories under /opt/solr.
